{
    "type": "json_schema",
    "name": "english_dictionary",
    "strict": true,
    "schema": {
        "type": "object",
        "properties": {
            "word": {
                "type": "string",
                "description": "The word being defined."
            },
            "phonetic_symbol": {
                "type": "string",
                "description": "The International Phonetic Alphabet of this word."
            },
            "meanings": {
                "type": "array",
                "description": "A list of meanings for the word, each with its part of speech, definition, and example sentences.",
                "items": {
                    "type": "object",
                    "properties": {
                        "part_of_speech": {
                            "type": "string",
                            "description": "The grammatical category to which the word belongs.",
                            "enum": [
                                "noun",
                                "verb",
                                "adjective",
                                "adverb",
                                "pronoun",
                                "preposition",
                                "conjunction",
                                "interjection"
                            ]
                        },
                        "definition": {
                            "type": "string",
                            "description": "A clear and concise explanation of the meaning of the word."
                        },
                        "examples": {
                            "type": "array",
                            "description": "A list of example sentences demonstrating the use of the word in this sense.",
                            "items": {
                                "type": "string"
                            },
                            "minItems": 1,
                            "maxItems": 2
                        }
                    },
                    "required": ["part_of_speech", "definition", "examples"],
                    "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 2
            },
            "synonyms": {
                "type": "array",
                "description": "A list of words that have similar meanings.",
                "items": {
                    "type": "string"
                },
                "minItems": 1,
                "maxItems": 3
            },
            "visual_reference": {
                "type": "object",
                "description": "Image display metadata for concrete object nouns. Set is_object_noun to true only when the word is used as a noun and refers to a physical object that can be pictured.",
                "properties": {
                    "is_object_noun": {
                        "type": "boolean",
                        "description": "Whether the word is a noun that refers to a physical object."
                    },
                    "image_query": {
                        "type": "string",
                        "description": "A short concrete image search phrase for the object noun, or an empty string when is_object_noun is false."
                    }
                },
                "required": ["is_object_noun", "image_query"],
                "additionalProperties": false
            }
        },
        "required": [
            "word",
            "phonetic_symbol",
            "meanings",
            "synonyms",
            "visual_reference"
        ],
        "additionalProperties": false
    }
}
